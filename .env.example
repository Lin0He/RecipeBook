APP_NAME=RecipeBook
APP_ENV=local

# Default true keeps the app runnable without downloading OCR/ASR models.
USE_MOCK_INFERENCE=true

# OCR
OCR_LANGUAGES=en
OCR_GPU=false

# ASR
ASR_MODEL_SIZE=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# LLM recipe structuring. If no key is configured, rule-based fallback is used.
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2

# Paths
VIDEO_DIR=data/videos
FRAME_DIR=data/frames
AUDIO_DIR=data/audio
CONTEXT_DIR=outputs/context
RECIPE_JSON_DIR=outputs/recipes/json
RECIPE_MARKDOWN_DIR=outputs/recipes/markdown

# Extraction settings
FRAME_INTERVAL_SECONDS=3
